# Server-side secrets — copy to .env (gitignored). Never expose these to the browser.

# Claude API key — powers the call analysis. https://platform.claude.com/
ANTHROPIC_API_KEY=

# AssemblyAI API key — powers transcription + speaker diarization. https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Shared access password — REQUIRED for any internet-facing deployment.
# When set, the browser asks for it before showing the app (any username).
# APP_PASSWORD=

# Optional overrides
# PORT=8787
# DATA_DIR=./data/reviews
# AUDIO_DIR=./data/audio
