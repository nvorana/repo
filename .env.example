# Server-side secrets — copy to .env (gitignored). Never expose these to the browser.

# Claude API key — powers the call analysis. https://platform.claude.com/
ANTHROPIC_API_KEY=

# AssemblyAI API key — powers transcription + speaker diarization. https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Role passwords — REQUIRED for any internet-facing deployment.
# Two shared passwords gate the app. Anyone with the rep password logs in as a
# salesperson (sees their own coaching); the manager password opens the team
# coaching view. Set at least one to turn login on.
REP_PASSWORD=
MANAGER_PASSWORD=

# Session signing secret — set this in production so logins survive redeploys.
# Any long random string. If unset, a new one is generated each boot (everyone
# is logged out on each restart).
# SESSION_SECRET=

# Optional overrides
# PORT=8787
# DATA_DIR=./data/reviews
# AUDIO_DIR=./data/audio
