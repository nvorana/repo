# Server-side secrets — copy to .env (gitignored). Never expose these to the browser.

# Claude API key — powers the call analysis. https://platform.claude.com/
ANTHROPIC_API_KEY=

# AssemblyAI API key — powers transcription + speaker diarization. https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# First manager account — seeded on first boot so you always have a way in.
# Requires MANAGER_EMAIL + MANAGER_PASSWORD (and optional MANAGER_NAME). Log in
# with the email + password, then add salespeople in the in-app "People" tab
# (each gets a first name + email + password). If you skip these, the first
# account you create in the app becomes the manager and logs you in.
MANAGER_NAME=Manager
MANAGER_EMAIL=
MANAGER_PASSWORD=

# Session signing secret — set this in production so logins survive redeploys.
# Any long random string. If unset, a new one is generated each boot (everyone
# is logged out on each restart).
# SESSION_SECRET=

# Optional overrides
# PORT=8787
# DATA_DIR=./data/reviews
# AUDIO_DIR=./data/audio
